{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WoT Descriptor profile fields",
  "description": "Compose with the generic Descriptor schema. Semantic relations and profile-defined annotation types need additional validation.",
  "type": "object",
  "properties": {
    "thingref": {"$ref": "#/$defs/thingRef"},
    "affordanceselector": {"$ref": "#/$defs/affordanceSelector"},
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "not": {"enum": ["thingdescription", "thingmodel"]}
          },
          "planurl": {"$ref": "#/$defs/absoluteUrl"}
        },
        "if": {"required": ["planurl"]},
        "then": {
          "required": ["class"],
          "properties": {
            "class": {
              "enum": [
                "https://xregistry.io/classes/thingdescription",
                "https://xregistry.io/classes/thingmodel"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "thingRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:_.-]{0,62}$"
    },
    "affordanceSelector": {
      "description": "Selects exactly one affordance. Additional annotation attributes require types and semantics from the applicable profile.",
      "type": "object",
      "required": ["pointer"],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^/(?:properties|actions|events)/(?:[^~/]|~[01])+$"
        }
      }
    },
    "absoluteUrl": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s#]+$"
    },
    "subjectDescriptor": {
      "type": "object",
      "required": ["thingref", "references"],
      "not": {"required": ["wotsubject"]},
      "properties": {
        "thingref": {"$ref": "#/$defs/thingRef"},
        "affordanceselector": {"$ref": "#/$defs/affordanceSelector"},
        "references": {"type": "object"}
      }
    },
    "tdReference": {
      "type": "object",
      "required": ["class", "url"],
      "properties": {
        "class": {"const": "https://xregistry.io/classes/thingdescription"},
        "url": {"$ref": "#/$defs/absoluteUrl"},
        "planurl": {"$ref": "#/$defs/absoluteUrl"}
      }
    },
    "tmReference": {
      "type": "object",
      "required": ["class", "url"],
      "properties": {
        "class": {"const": "https://xregistry.io/classes/thingmodel"},
        "url": {"$ref": "#/$defs/absoluteUrl"},
        "planurl": {"$ref": "#/$defs/absoluteUrl"}
      }
    }
  }
}
