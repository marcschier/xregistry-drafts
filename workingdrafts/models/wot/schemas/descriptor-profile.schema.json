{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WoT Descriptor profile fields",
  "description": "Compose with the generic Descriptor schema. Global Reference-name uniqueness, selector relations and profile-defined inline data or annotation semantics need additional validation.",
  "type": "object",
  "properties": {
    "thingref": {"$ref": "#/$defs/thingRef"},
    "affordanceselector": {"$ref": "#/$defs/affordanceSelector"},
    "references": {"$ref": "#/$defs/referenceBuckets"},
    "data": {"$ref": "#/$defs/dataBuckets"}
  },
  "$defs": {
    "typeKey": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^(?:[a-z][a-z0-9]*|[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+)$"
    },
    "thingRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:_.-]{0,62}$"
    },
    "referenceBuckets": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/typeKey"},
      "properties": {
        "thingdescription": {"$ref": "#/$defs/wotBucket"},
        "thingmodel": {"$ref": "#/$defs/wotBucket"}
      },
      "additionalProperties": {"$ref": "#/$defs/otherBucket"}
    },
    "wotBucket": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/thingRef"},
      "additionalProperties": {"$ref": "#/$defs/wotReference"}
    },
    "otherBucket": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/thingRef"},
      "additionalProperties": {
        "$ref": "#/$defs/reference",
        "properties": {"planurl": false}
      }
    },
    "dataBuckets": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/typeKey"}
    },
    "reference": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"$ref": "#/$defs/absoluteUrl"},
        "class": false
      }
    },
    "wotReference": {
      "$ref": "#/$defs/reference",
      "properties": {
        "planurl": {"$ref": "#/$defs/absoluteUrl"}
      }
    },
    "affordanceSelector": {
      "description": "Selects exactly one affordance. Additional annotation attributes require types and semantics from the applicable profile.",
      "type": "object",
      "required": ["pointer"],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^/(?:properties|actions|events)/(?:[^~/]|~[01])+$"
        }
      }
    },
    "absoluteUrl": {
      "type": "string",
      "$comment": "RFC 3986 absolute-URI grammar, including IP literals and percent-encoded characters.",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:(?://(?:(?:[-A-Za-z0-9._~!$&'()*+,;=:]|%[0-9A-Fa-f]{2})*@)?(?:\\[(?:(?:[0-9A-Fa-f]{1,4}:){6}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|::(?:[0-9A-Fa-f]{1,4}:){5}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){4}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,1}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){3}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,2}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){2}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,4}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,5}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,6}[0-9A-Fa-f]{1,4})?::|[vV][0-9A-Fa-f]+\\.[-A-Za-z0-9._~!$&'()*+,;=:]+)\\]|(?:[-A-Za-z0-9._~!$&'()*+,;=]|%[0-9A-Fa-f]{2})*)(?::[0-9]*)?(?:/(?:[-A-Za-z0-9._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})*)*|/(?!/)(?:[-A-Za-z0-9._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})*(?:/(?:[-A-Za-z0-9._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})*)*|(?:[-A-Za-z0-9._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})+(?:/(?:[-A-Za-z0-9._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})*)*|)(?:\\?(?:[-A-Za-z0-9._~!$&'()*+,;=:@/?]|%[0-9A-Fa-f]{2})*)?(?![\\s\\S])"
    },
    "subjectDescriptor": {
      "type": "object",
      "required": ["thingref", "references"],
      "not": {"required": ["wotsubject"]},
      "properties": {
        "thingref": {"$ref": "#/$defs/thingRef"},
        "affordanceselector": {"$ref": "#/$defs/affordanceSelector"},
        "references": {"$ref": "#/$defs/referenceBuckets"},
        "data": {"$ref": "#/$defs/dataBuckets"}
      }
    }
  }
}
