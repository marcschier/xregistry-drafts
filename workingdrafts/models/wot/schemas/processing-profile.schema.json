{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xregistry.io/workingdrafts/models/wot/schemas/processing-profile.schema.json",
  "title": "xRegistry WoT Processing Profile Descriptor",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "version",
    "definition",
    "operations",
    "roles",
    "representationProfiles"
  ],
  "properties": {
    "formatVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque descriptor revision label; consumers compare it exactly and do not interpret it as a SemVer range"
    },
    "definition": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "resolve-definition"
        ]
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "tm:ref"
        ]
      }
    },
    "representationProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "decoded-file-octets"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha-256:[0-9a-f]{64}$"
    }
  }
}
