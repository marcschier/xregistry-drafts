{
  "wot": {
    "type": "object",
    "description": "WoT data bucket; subject and event are independently optional.",
    "attributes": {
      "subject": {
        "type": "object",
        "attributes": {
          "thingref": {"type": "string", "required": true},
          "affordanceselector": {"type": "string"}
        }
      },
      "event": {
        "type": "object",
        "attributes": {
          "type": {"type": "string", "required": true},
          "modelref": {"type": "string", "required": true},
          "affordanceselector": {"type": "string"}
        }
      }
    }
  }
}
