{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xregistry.io/workingdrafts/models/descriptor/schemas/document-schema.json",
  "properties": {
    "descriptorgroups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/descriptorgroup-schema/descriptorgroup"
      }
    }
  },
  "definitions": {
    "descriptorgroup-schema": {
      "descriptorVersion": {
        "type": "object",
        "properties": {
          "versionid": {
            "type": "string",
            "description": "ID of the descriptor version"
          },
          "descriptorid": {
            "type": "string",
            "description": "ID of the descriptor object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri-reference",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          },
          "references": {
            "type": "object",
            "description": "Named References. The map can be empty; names do not imply a class or message role",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string",
                  "description": "Standard representation class or absolute URI class identifier"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^#]*$",
                  "description": "Absolute fragment-free retrieval URL, used without modification"
                },
                "planurl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^#]*$",
                  "description": "Optional projection-plan provenance for a resolved TD or TM; not a bundle input"
                }
              },
              "required": [
                "class",
                "url"
              ]
            }
          },
          "entityid": {
            "type": "string",
            "format": "uri-reference",
            "description": "Absolute fragment-free identity URI of the primary entity; not a retrieval instruction"
          },
          "entitytype": {
            "type": "string",
            "format": "uri-reference",
            "description": "Absolute fragment-free type URI from an agreed vocabulary; requires entityid"
          },
          "messageref": {
            "type": "string",
            "description": "Exact name of an existing message Reference"
          },
          "schemaref": {
            "type": "string",
            "description": "Exact name of an existing schema Reference selected as the Descriptor's payload schema"
          }
        },
        "required": [
          "references"
        ]
      },
      "descriptor": {
        "type": "object",
        "properties": {
          "descriptorid": {
            "type": "string",
            "description": "ID of the descriptor object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri-reference",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          },
          "versionsurl": {
            "type": "string",
            "format": "uri"
          },
          "versionscount": {
            "type": "integer"
          },
          "versions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/descriptorgroup-schema/descriptorVersion"
            }
          }
        }
      },
      "descriptorgroup": {
        "type": "object",
        "properties": {
          "descriptorgroupid": {
            "type": "string",
            "description": "ID of the descriptorgroup object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch time of the object creation"
          },
          "self": {
            "type": "string",
            "format": "uri-reference",
            "description": "URL of the object"
          },
          "xid": {
            "type": "string",
            "format": "xid",
            "description": "Relative URL of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI of the documentation of the object"
          },
          "labels": {
            "type": "object",
            "description": "Labels for the object"
          },
          "createdat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object creation"
          },
          "modifiedat": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the object modification"
          },
          "descriptors": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/descriptorgroup-schema/descriptor"
            }
          }
        }
      }
    }
  }
}