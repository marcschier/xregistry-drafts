{
  "$schema": "https://json-structure.org/meta/extended/v0/#",
  "$id": "https://xregistry.io/workingdrafts/models/descriptor/schemas/document-schema.struct.json",
  "$uses": [
    "JSONStructureAlternateNames"
  ],
  "name": "DescriptorRegistryDocument",
  "type": "object",
  "properties": {
    "descriptorgroups": {
      "type": "map",
      "values": {
        "type": {
          "$ref": "#/definitions/Descriptorgroups/Descriptorgroup"
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Descriptorgroups": {
      "DescriptorVersionReferencesValue": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "description": "Standard representation class or absolute URI class identifier"
          },
          "url": {
            "type": "uri",
            "description": "Absolute fragment-free retrieval URL, used without modification"
          },
          "planurl": {
            "type": "uri",
            "description": "Optional projection-plan provenance for a resolved TD or TM; not a bundle input"
          }
        },
        "additionalProperties": true,
        "required": [
          "class",
          "url"
        ]
      },
      "DescriptorVersion": {
        "type": "object",
        "properties": {
          "versionid": {
            "type": "string",
            "description": "ID of the descriptor version"
          },
          "descriptorid": {
            "type": "string",
            "description": "ID of the descriptor object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "references": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Descriptorgroups/DescriptorVersionReferencesValue"
              }
            },
            "description": "Named References. The map can be empty; names do not imply a class or message role"
          },
          "entityid": {
            "type": "uri",
            "description": "Absolute fragment-free identity URI of the primary entity; not a retrieval instruction"
          },
          "entitytype": {
            "type": "uri",
            "description": "Absolute fragment-free type URI from an agreed vocabulary; requires entityid"
          },
          "messageref": {
            "type": "string",
            "description": "Exact name of an existing message Reference"
          },
          "schemaref": {
            "type": "string",
            "description": "Exact name of an existing schema Reference selected as the Descriptor's payload schema"
          }
        },
        "additionalProperties": true,
        "required": [
          "references"
        ]
      },
      "Descriptor": {
        "type": "object",
        "properties": {
          "descriptorid": {
            "type": "string",
            "description": "ID of the descriptor object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "versionsurl": {
            "type": "uri"
          },
          "versionscount": {
            "type": "uint32"
          },
          "versions": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Descriptorgroups/DescriptorVersion"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "Descriptorgroup": {
        "type": "object",
        "properties": {
          "descriptorgroupid": {
            "type": "string",
            "description": "ID of the descriptorgroup object"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "epoch": {
            "type": "integer",
            "description": "Epoch of the object"
          },
          "self": {
            "type": "uri",
            "description": "URL of the object"
          },
          "xid": {
            "type": "uri",
            "description": "XID of the object"
          },
          "description": {
            "type": "string",
            "description": "Description of the object"
          },
          "documentation": {
            "type": "uri",
            "description": "Documentation URL"
          },
          "labels": {
            "type": "map",
            "values": {
              "type": "string"
            }
          },
          "createdat": {
            "type": "datetime",
            "description": "Creation time"
          },
          "modifiedat": {
            "type": "datetime",
            "description": "Modification time"
          },
          "descriptors": {
            "type": "map",
            "values": {
              "type": {
                "$ref": "#/definitions/Descriptorgroups/Descriptor"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}