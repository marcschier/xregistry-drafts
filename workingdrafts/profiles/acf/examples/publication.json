  "https://registry.example/conversationgroups/demo/conversations/normalize/versions/1": {
    "$schema": "https://raw.githubusercontent.com/clemensv/acf/main/specification/schemas/acf-1.0.struct.json",
    "id": "NormalizeReading",
    "name": "Normalize one sensor reading",
    "actors": [
      { "id": "Sender", "kind": "service" },
      { "id": "Worker", "kind": "service" },
      { "id": "Receiver", "kind": "service" }
    ],
    "scopes": [
      {
        "name": "Reading",
        "operator": "sequence",
        "initiator": "Sender",
        "terminals": [
          {
            "terminalid": "SenderOut",
            "actorid": "Sender",
            "direction": "producer",
            "messagegroups": ["/messagegroups/readings"]
          },
          {
            "terminalid": "WorkerIn",
            "actorid": "Worker",
            "direction": "consumer",
            "messagegroups": ["/messagegroups/readings"]
          },
          {
            "terminalid": "WorkerOut",
            "actorid": "Worker",
            "direction": "producer",
            "messagegroups": ["/messagegroups/readings"]
          },
          {
            "terminalid": "ReceiverIn",
            "actorid": "Receiver",
            "direction": "consumer",
            "messagegroups": ["/messagegroups/readings"]
          }
        ],
        "operands": [
          {
            "steps": [
              {
                "type": "flow",
                "id": "RawHop",
                "from": "SenderOut",
                "to": "WorkerIn",
                "message": "/messagegroups/readings/messages/raw/versions/1"
              },
              {
                "type": "action",
                "id": "Normalize",
                "actor": "Worker",
                "inputs": [
                  {
                    "terminal": "WorkerIn",
                    "message": "/messagegroups/readings/messages/raw/versions/1"
                  }
                ],
                "outputs": [
                  {
                    "terminal": "WorkerOut",
                    "message": "/messagegroups/readings/messages/normalized/versions/1"
                  }
                ]
              },
              {
                "type": "flow",
                "id": "NormalizedHop",
                "from": "WorkerOut",
                "to": "ReceiverIn",
                "message": "/messagegroups/readings/messages/normalized/versions/1"
              }
            ]
          }
        ]
      }
    ]
  },
