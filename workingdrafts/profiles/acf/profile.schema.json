{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xregistry.io/workingdrafts/profiles/acf/profile.schema.json",
  "description": "Select a partial definition explicitly. Descriptor and ACF constraints apply separately.",
  "not": {},
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:_.-]{0,62}$"
    },
    "id": { "type": "string", "minLength": 1 },
    "acfId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "absoluteUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^#\\s]+$"
    },
    "absoluteUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^/#?\\s]+[^#\\s]*$"
    },
    "actorBinding": {
      "type": "object",
      "required": ["actor", "mode"],
      "additionalProperties": false,
      "properties": {
        "actor": { "$ref": "#/definitions/acfId" },
        "mode": { "enum": ["fixed", "runtime"] },
        "participant": { "$ref": "#/definitions/absoluteUri" },
        "actorref": { "$ref": "#/definitions/name" },
        "allowedparticipants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/absoluteUri" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fixed" } } },
          "then": {
            "required": ["participant"],
            "not": { "required": ["allowedparticipants"] }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "runtime" } } },
          "then": {
            "not": { "anyOf": [
              { "required": ["participant"] },
              { "required": ["actorref"] }
            ] }
          }
        }
      ]
    },
    "deployment": {
      "type": "object",
      "required": ["acfconversation"],
      "not": { "required": ["acfexecution"] },
      "properties": {
        "acfconversation": {
          "type": "object",
          "required": ["conversationref", "resolutioncontextref", "actorbindings"],
          "additionalProperties": false,
          "properties": {
            "conversationref": { "$ref": "#/definitions/name" },
            "resolutioncontextref": { "$ref": "#/definitions/name" },
            "actorbindings": {
              "type": "array",
              "items": { "$ref": "#/definitions/actorBinding" }
            },
            "messagebindings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["step", "processingref"],
                "additionalProperties": false,
                "properties": {
                  "step": { "$ref": "#/definitions/acfId" },
                  "processingref": { "$ref": "#/definitions/name" }
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["entityid", "entitytype", "acfexecution"],
      "not": { "required": ["acfconversation"] },
      "properties": {
        "entityid": { "$ref": "#/definitions/absoluteUri" },
        "entitytype": {
          "const": "https://xregistry.io/workingdrafts/profiles/acf/types/execution"
        },
        "acfexecution": {
          "type": "object",
          "required": ["traceref", "traceid"],
          "additionalProperties": false,
          "properties": {
            "traceref": { "$ref": "#/definitions/name" },
            "traceid": { "$ref": "#/definitions/acfId" },
            "supersedes": { "$ref": "#/definitions/name" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["executionid", "deploymenturl"],
      "additionalProperties": false,
      "properties": {
        "executionid": { "$ref": "#/definitions/absoluteUri" },
        "deploymenturl": { "$ref": "#/definitions/absoluteUrl" },
        "actordescriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["actor", "actorurl"],
            "additionalProperties": false,
            "properties": {
              "actor": { "$ref": "#/definitions/acfId" },
              "actorurl": { "$ref": "#/definitions/absoluteUrl" }
            }
          }
        },
        "previous": {
          "type": "object",
          "required": ["url", "traceid"],
          "additionalProperties": false,
          "properties": {
            "url": { "$ref": "#/definitions/absoluteUrl" },
            "traceid": { "$ref": "#/definitions/acfId" }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["source", "id"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "id": { "$ref": "#/definitions/id" }
      }
    },
    "observation": {
      "type": "object",
      "required": ["observationid", "kind", "observer", "event"],
      "additionalProperties": false,
      "properties": {
        "observationid": { "$ref": "#/definitions/id" },
        "kind": { "enum": ["sent", "received", "accepted", "processed"] },
        "observer": { "$ref": "#/definitions/absoluteUri" },
        "event": { "$ref": "#/definitions/event" },
        "processingurl": { "$ref": "#/definitions/absoluteUrl" },
        "corrects": { "$ref": "#/definitions/id" }
      }
    },
    "eventUse": {
      "type": "object",
      "required": ["event", "observationids"],
      "additionalProperties": false,
      "properties": {
        "event": { "$ref": "#/definitions/event" },
        "processingurl": { "$ref": "#/definitions/absoluteUrl" },
        "observationids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["activityid", "step", "participant", "inputs", "outputs", "outcome"],
      "additionalProperties": false,
      "properties": {
        "activityid": { "$ref": "#/definitions/id" },
        "step": { "$ref": "#/definitions/acfId" },
        "participant": { "$ref": "#/definitions/absoluteUri" },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/eventUse" }
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/eventUse" }
        },
        "outcome": { "enum": ["succeeded", "failed", "partial", "unknown"] },
        "corrects": { "$ref": "#/definitions/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "failed" } } },
          "then": { "properties": { "outputs": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "partial" } } },
          "then": { "properties": { "outputs": { "minItems": 1 } } }
        }
      ]
    },
    "attempts": {
      "type": "array",
      "items": { "$ref": "#/definitions/attempt" }
    }
  }
}
