{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xregistry.io/workingdrafts/profiles/acf/profile.schema.json",
  "description": "Partial profile constraints. Select a definition explicitly; the root validates no instance. Generic Descriptor and ACF constraints apply separately.",
  "not": {},
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:_.-]{0,62}$"
    },
    "id": { "type": "string", "minLength": 1 },
    "acfId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "actorBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "actorref"],
        "additionalProperties": false,
        "properties": {
          "actor": { "$ref": "#/definitions/acfId" },
          "actorref": { "$ref": "#/definitions/name" }
        }
      }
    },
    "messageBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "processingref"],
        "additionalProperties": false,
        "properties": {
          "step": { "$ref": "#/definitions/acfId" },
          "processingref": { "$ref": "#/definitions/name" }
        }
      }
    },
    "conversation": {
      "type": "object",
      "required": ["acfconversation"],
      "not": { "required": ["acfexecution"] },
      "properties": {
        "acfconversation": {
          "type": "object",
          "required": ["conversationref", "resolutioncontextref"],
          "additionalProperties": false,
          "properties": {
            "conversationref": { "$ref": "#/definitions/name" },
            "resolutioncontextref": { "$ref": "#/definitions/name" },
            "actorbindings": { "$ref": "#/definitions/actorBindings" },
            "messagebindings": { "$ref": "#/definitions/messageBindings" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["entityid", "entitytype", "acfexecution"],
      "not": { "required": ["acfconversation"] },
      "properties": {
        "entityid": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^#\\s]+$"
        },
        "entitytype": {
          "const": "https://xregistry.io/workingdrafts/profiles/acf/types/execution"
        },
        "acfexecution": {
          "type": "object",
          "required": ["configurationref", "traceref", "traceid"],
          "additionalProperties": false,
          "properties": {
            "configurationref": { "$ref": "#/definitions/name" },
            "traceref": { "$ref": "#/definitions/name" },
            "traceid": { "$ref": "#/definitions/acfId" },
            "actorbindings": { "$ref": "#/definitions/actorBindings" },
            "supersedes": { "$ref": "#/definitions/name" }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["source", "id"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "id": { "$ref": "#/definitions/id" }
      }
    },
    "observation": {
      "type": "object",
      "required": ["observationid", "kind", "observerref", "event"],
      "additionalProperties": false,
      "properties": {
        "observationid": { "$ref": "#/definitions/id" },
        "kind": { "enum": ["sent", "received", "accepted", "processed"] },
        "observerref": { "$ref": "#/definitions/name" },
        "event": { "$ref": "#/definitions/event" },
        "processingref": { "$ref": "#/definitions/name" },
        "corrects": { "$ref": "#/definitions/id" }
      },
      "if": {
        "properties": { "kind": { "const": "processed" } },
        "required": ["kind"]
      },
      "then": { "required": ["processingref"] }
    },
    "eventUse": {
      "type": "object",
      "required": ["event", "processingref", "observationids"],
      "additionalProperties": false,
      "properties": {
        "event": { "$ref": "#/definitions/event" },
        "processingref": { "$ref": "#/definitions/name" },
        "observationids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["activityid", "step", "actorref", "inputs", "outputs", "outcome"],
      "additionalProperties": false,
      "properties": {
        "activityid": { "$ref": "#/definitions/id" },
        "step": { "$ref": "#/definitions/acfId" },
        "actorref": { "$ref": "#/definitions/name" },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/eventUse" }
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/eventUse" }
        },
        "outcome": { "enum": ["succeeded", "failed", "partial", "unknown"] },
        "corrects": { "$ref": "#/definitions/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "failed" } } },
          "then": { "properties": { "outputs": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "partial" } } },
          "then": { "properties": { "outputs": { "minItems": 1 } } }
        }
      ]
    },
    "attempts": {
      "type": "array",
      "items": { "$ref": "#/definitions/attempt" }
    }
  }
}
